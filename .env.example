# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# AI_PROVIDER: 'gemini' or 'fixture' (default: fixture)
AI_PROVIDER=fixture

# RESEARCH_PROVIDER: 'live' or 'fixture' (default: fixture)
RESEARCH_PROVIDER=fixture

# IMAGE_PROVIDER: 'gemini' or 'fixture' (default: fixture)
IMAGE_PROVIDER=fixture

# FIXTURE_FAIL_STAGE: Optional deterministic stage failure simulation (e.g. 'IMAGE_VERTICAL')
FIXTURE_FAIL_STAGE=

# DATABASE_URL: SQLite database path for Prisma
DATABASE_URL="file:./dev.db"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
